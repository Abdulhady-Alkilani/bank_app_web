# Copy to .env for `docker compose up -d --build`  (cp .env.docker.example .env)
APP_NAME="Fraud Detection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bank_db
DB_USERNAME=bank
DB_PASSWORD=bank_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fraud.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Host port for nginx (http://localhost:8080)
WEB_PORT=8080

# Seed demo data on first start (only runs when the users table is empty)
SEED=true

# AI scoring: fake (in-process) | http (FastAPI service, see plan/AI_SERVICE_CONTRACT.md) | none
# Switch to http and start the service with: docker compose --profile ai up -d --build
AI_DRIVER=fake
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=250
FRAUD_FEATURE_CACHE_STORE=

BANK_WEBHOOK_URL=
BANK_WEBHOOK_SECRET=
ML_INGEST_TOKEN=change-me-ml-token
# Shadow scoring (POST /v1/shadow/score, queued, never affects decisions) and champion reload (POST /admin/reload)
AI_SHADOW_ENABLED=false
AI_ADMIN_TOKEN=
# Where the Python service source lives (docker build context for the ai profile)
AI_SERVICE_BUILD_CONTEXT=../ai_model
